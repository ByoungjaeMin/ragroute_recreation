# -----------------------------------------------------------------------
# Data — large files and generated artifacts never go to GitHub
# -----------------------------------------------------------------------

# Raw corpora (MedRAG corpus chunks, Wikipedia snippets — too large)
data/raw/

# Generated embeddings (.npy), FAISS indices (.faiss), chunk JSONs
data/embeddings/

# Processed training data (X_train/y_train/... .npy, split JSONs)
data/processed/

# FAISS stats files (centroid/cluster_stats JSONs)
data/stats/

# Benchmark files — committed to repo for reproducibility
# data/benchmark/MIRAGE.json and data/question_order_*.json are tracked

# External repos cloned by setup scripts
external/

# -----------------------------------------------------------------------
# Model checkpoints and scalers
# -----------------------------------------------------------------------
checkpoints/

# -----------------------------------------------------------------------
# Evaluation results
# -----------------------------------------------------------------------
results/

